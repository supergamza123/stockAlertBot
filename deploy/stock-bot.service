[Unit]
Description=Stock Alert Discord Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/stockAlertBot
EnvironmentFile=/home/ubuntu/stockAlertBot/.env
ExecStart=/home/ubuntu/stockAlertBot/.venv/bin/python bot.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
