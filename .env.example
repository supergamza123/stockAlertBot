# 디스코드 봇 토큰 (Discord Developer Portal에서 발급)
DISCORD_TOKEN=여기에_봇_토큰을_붙여넣으세요

# 명령어 접두사 (기본값: !)
COMMAND_PREFIX=!

# ───────────────────────────────────────────────
# (선택) 토스증권 Open API 연동 - 내 계좌 보유종목 조회용
# 토스증권 WTS(PC 웹) → 설정 → Open API 에서 발급
# ⚠️ 이 값들은 실제 내 증권계좌에 접근하는 비밀키입니다. 절대 외부 공개 금지!
# ───────────────────────────────────────────────
# 아래 TOSS_* 값은 "봇 운영자 본인 계좌"용 기본값입니다(선택).
# 사용자들은 각자 디스코드에서 !등록 명령으로 자기 키를 등록하면,
# 각자 자기 계좌만 조회하게 됩니다. 그 경우 아래 값은 비워둬도 됩니다.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
# 기본으로 사용할 계좌번호 (비워두면 첫 번째 계좌 자동 사용)
TOSS_ACCOUNT=

# 사용자별 키 암호화에 쓰는 마스터키 (선택).
# 비워두면 최초 실행 시 .secret.key 파일이 자동 생성됩니다.
# 여러 서버/재배포에서 저장된 키를 계속 쓰려면 아래 명령으로 생성해 고정하세요:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
